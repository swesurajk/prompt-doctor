# Copy to .env.local and fill in. .env.local is git-ignored and never committed.
# tools/eval.mjs loads it automatically, so `npm run eval` works with no flags.
# Command-line flags and real environment variables both override these.

# anthropic | openai | google | custom
PROMPT_DOCTOR_PROVIDER=custom

# Only for provider=custom. Must serve POST {base}/chat/completions.
# Groq: https://api.groq.com/openai/v1 · Ollama: http://localhost:11434/v1
PROMPT_DOCTOR_BASE_URL=https://api.groq.com/openai/v1

PROMPT_DOCTOR_MODEL=llama-3.3-70b-versatile

# Your own key for the provider above. Never commit this.
PROMPT_DOCTOR_KEY=
